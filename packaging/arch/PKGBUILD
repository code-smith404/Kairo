# Maintainer: Kairo contributors
pkgname=kairo-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="MangoWM-inspired tiling Wayland compositor written in Zig"
arch=('x86_64' 'aarch64')
url="https://github.com/code-smith404/Kairo"
license=('MIT')
depends=('wlroots0.20' 'scenefx' 'wayland' 'libxkbcommon' 'pixman' 'libdrm' 'mesa' 'xorg-xwayland')
makedepends=('git' 'zig' 'base-devel')
source=("git+${url}")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/Kairo"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/Kairo"
    zig build -Doptimize=ReleaseSafe
}

package() {
    cd "$srcdir/Kairo"
    install -Dm755 zig-out/bin/kairo "$pkgdir/usr/bin/kairo"
    install -Dm755 zig-out/bin/kairoctl "$pkgdir/usr/bin/kairoctl"
    install -Dm755 zig-out/bin/kairo-shell "$pkgdir/usr/bin/kairo-shell"
    install -Dm644 README.md "$pkgdir/usr/share/doc/kairo/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/kairo/LICENSE"
    install -Dm644 examples/config "$pkgdir/usr/share/doc/kairo/examples/config"
    install -Dm644 docs/configuration.md "$pkgdir/usr/share/doc/kairo/configuration.md"
    install -Dm644 docs/keybindings.md "$pkgdir/usr/share/doc/kairo/keybindings.md"
    install -Dm644 docs/ipc.md "$pkgdir/usr/share/doc/kairo/ipc.md"
    install -Dm644 packaging/wayland-sessions/kairo.desktop \
        "$pkgdir/usr/share/wayland-sessions/kairo.desktop"
}
