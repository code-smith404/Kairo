/**
 * Kairo launcher theme for Rofi 2.x (wayland build).
 * Colors match the Kairo bar palette; install to ~/.config/rofi/kairo.rasi
 * and launch with: rofi -show drun -theme kairo
 */
* {
    background:     #0b0d12;
    background-alt: #1c202a;
    foreground:     #e6ebf4;
    accent:         #3f8ce8;
    urgent:         #e8a53f;

    border-color:   @accent;
    font: "Sans 12";
}

window {
    location: center;
    width: 640px;
    border: 1px;
    border-radius: 8px;
    background-color: @background;
}

inputbar {
    background-color: @background-alt;
    border-radius: 6px;
    margin: 8px;
    padding: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    padding: 0 8px 0 4px;
}

entry {
    text-color: @foreground;
}

listview {
    lines: 8;
    margin: 0 8px 8px 8px;
    fixed-height: false;
}

element {
    padding: 6px;
    border-radius: 6px;
    text-color: @foreground;
}

element selected normal normal {
    background-color: @accent;
    text-color: #ffffff;
}

element alternate normal {
    background-color: transparent;
}

element urgent {
    text-color: @urgent;
}

element-icon {
    size: 24px;
    padding: 0 8px 0 0;
}

mode-switcher {
    margin: 0 8px;
}

button {
    text-color: @foreground;
    padding: 6px;
}

button selected {
    background-color: @accent;
    text-color: #ffffff;
}
